{
  "expo": {
    "name": "Njangi",
    "slug": "njangi",
    "owner": "dev-5304",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "njangi",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/649b5443-414d-4e91-96fb-67800f3dd917",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.truesignal.njangi",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#6C3F5E"
      },
      "package": "com.truesignal.njangi",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#263C31",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#111914",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "@clerk/expo",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Njangi utilise Face ID pour ouvrir votre carnet en sécurité. / Njangi uses Face ID to open your ledger securely."
        }
      ],
      "expo-image",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Njangi accède à vos photos pour joindre une preuve de paiement. / Njangi accesses your photos to attach payment proof.",
          "cameraPermission": "Njangi utilise l'appareil photo pour photographier une preuve de paiement. / Njangi uses the camera to photograph payment proof."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "njangi",
          "organization": "true-signal-digital"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "onDemandFilesystem": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "649b5443-414d-4e91-96fb-67800f3dd917"
      }
    }
  }
}
