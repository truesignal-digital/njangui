{
  "expo": {
    "name": "Njangi",
    "slug": "njangi",
    "owner": "dev-5304s-organization",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "njangi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.truesignal.njangi",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0C1222"
      },
      "package": "com.truesignal.njangi",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1222",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0C1222",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "@clerk/expo",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Njangi utilise Face ID pour ouvrir votre carnet en sécurité. / Njangi uses Face ID to open your ledger securely."
        }
      ],
      "expo-image",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Njangi accède à vos photos pour joindre une preuve de paiement. / Njangi accesses your photos to attach payment proof.",
          "cameraPermission": "Njangi utilise l'appareil photo pour photographier une preuve de paiement. / Njangi uses the camera to photograph payment proof."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "onDemandFilesystem": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e03e6f99-4977-406b-906f-4b601729b64d"
      }
    }
  }
}
