# ── Njangi environment variables (Expo mobile app) ─────────────────────────
# Copy to .env.local and fill in. Never commit real values.
#
# CUSTODY-FREE RED LINE: no payment-provider keys for member money will ever
# be added here (no MTN MoMo / Orange Money / PSP APIs). See docs/00-overview.md.

# Deployment used by `bunx convex dev` (creates a NEW deployment; do NOT
# reuse piol's).
CONVEX_DEPLOYMENT=dev:your-deployment

# Convex deployment URL — printed by `bunx convex dev`.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (phone-number-first authentication — SMS OTP as primary identifier)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk webhook signing secret (Clerk Dashboard → Webhooks → endpoint
# https://<convex-deployment>.convex.site/clerk-webhook).
# Set CLERK_WEBHOOK_SECRET and CLERK_JWT_ISSUER_DOMAIN in the Convex
# Dashboard → Settings → Environment Variables (they run server-side; the
# mobile app never sees them).

# Optional: canonical site URL used for share copy / universal links later
# (defaults to https://njangi.app).
# EXPO_PUBLIC_SITE_URL=https://njangi.app
