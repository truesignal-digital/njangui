{
  "name": "njangi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "node ./scripts/patch-clerk-ios-simulator-keychain.js && expo run:ios",
    "mcp:start": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "mcp:ios": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --ios",
    "mcp:android": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --android",
    "mcp:dev-client": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "run:ios": "node ./scripts/patch-clerk-ios-simulator-keychain.js && expo run:ios",
    "run:android": "expo run:android",
    "prebuild": "expo prebuild",
    "convex:dev": "bunx convex dev",
    "eas:build:development:ios": "npx eas-cli@latest build -p ios --profile development",
    "eas:build:development:simulator": "npx eas-cli@latest build -p ios --profile development-simulator",
    "eas:build:development:android": "npx eas-cli@latest build -p android --profile development",
    "eas:build:preview:ios": "npx eas-cli@latest build -p ios --profile preview",
    "eas:build:preview:android": "npx eas-cli@latest build -p android --profile preview",
    "eas:build:testflight": "npx eas-cli@latest build -p ios --profile testflight",
    "eas:build:production": "npx eas-cli@latest build -p all --profile production",
    "export:web": "expo export --platform web",
    "eas:deploy:web:preview": "npx eas-cli@latest deploy",
    "eas:deploy:web:production": "npx eas-cli@latest deploy --prod",
    "eas:submit:testflight": "npx eas-cli@latest submit -p ios --profile testflight --latest",
    "eas:submit:play-internal": "npx eas-cli@latest submit -p android --profile production --latest",
    "eas:run:ios": "npx eas-cli@latest build:run -p ios --latest",
    "eas:run:android": "npx eas-cli@latest build:run -p android --latest",
    "test": "bun run test:unit && bun run test:convex",
    "test:unit": "bun test convex/lib src/lib",
    "test:convex": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:design": "bun scripts/lint-design-system.ts",
    "release:status": "bun scripts/release-status.ts",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@clerk/expo": "^3.7.8",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~57.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "buffer": "^6.0.3",
    "connect": "^3.7.0",
    "convex": "^1.32.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-build-properties": "~57.0.3",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "~57.0.0",
    "expo-localization": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "i18next": "^25.8.14",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.6",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "sonner-native": "0.25.1",
    "svix": "^1.95.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/react": "~19.2.10",
    "convex-test": "^0.0.54",
    "expo-mcp": "~0.2.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "serve-sim": "0.1.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
