{
  "name": "njangi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "node ./scripts/patch-clerk-ios-simulator-keychain.js && expo run:ios",
    "mcp:start": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "mcp:ios": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --ios",
    "mcp:android": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --android",
    "mcp:dev-client": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "run:ios": "node ./scripts/patch-clerk-ios-simulator-keychain.js && expo run:ios",
    "run:android": "expo run:android",
    "prebuild": "expo prebuild",
    "convex:dev": "bunx convex dev",
    "eas:build:development:ios": "npx eas-cli@latest build -p ios --profile development",
    "eas:build:development:simulator": "npx eas-cli@latest build -p ios --profile development-simulator",
    "eas:build:development:android": "npx eas-cli@latest build -p android --profile development",
    "eas:build:preview:android": "npx eas-cli@latest build -p android --profile preview",
    "eas:run:ios": "npx eas-cli@latest build:run -p ios --latest",
    "eas:run:android": "npx eas-cli@latest build:run -p android --latest",
    "typecheck": "tsc --noEmit",
    "lint:design": "bun scripts/lint-design-system.ts",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@clerk/expo": "^3.0.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "buffer": "^6.0.3",
    "connect": "^3.7.0",
    "convex": "^1.32.0",
    "expo": "^56.0.4",
    "expo-auth-session": "~56.0.14",
    "expo-build-properties": "~56.0.14",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.15",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-picker": "~56.0.19",
    "expo-linking": "~56.0.11",
    "expo-local-authentication": "~56.0.4",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.0",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "i18next": "^25.8.14",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.6",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-heroicons": "^4.0.0",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "sonner-native": "0.25.1",
    "svix": "^1.95.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo-mcp": "~0.2.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "serve-sim": "0.1.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
